{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "retirement-assistant",
  "main": "src/index.js",
  "compatibility_date": "2026-07-27",
  "workers_dev": true,
  "secrets": {
    "required": ["OPENAI_API_KEY"]
  },
  "vars": {
    "OPENAI_MODEL": "gpt-5-mini"
  },
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ]
}
